{
    "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}name: CI/CD - Testing Branch

on:
  push:
    branches:
      - testing
    paths-ignore:
      - 'docker-compose.yml'

env:
  FRONTEND_IMAGE: radykh/international_knowledge_front
  BACKEND_IMAGE: radykh/international_knowledge_back
  AI_IMAGE: radykh/international_knowledge_ai
  NGINX_IMAGE: radykh/international_knowledge_nginx

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to DockerHub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      # -----------------------------
      # Build & Push Frontend
      # -----------------------------
      - name: Build & Push Frontend
        uses: docker/build-push-action@v5
        with:
          context: ./client
          file: ./client/Dockerfile
          push: true
          tags: |
            ${{ env.FRONTEND_IMAGE }}:${{ github.sha }}
            ${{ env.FRONTEND_IMAGE }}:testing

      # -----------------------------
      # Build & Push Backend
      # -----------------------------
      - name: Build & Push Backend
        uses: docker/build-push-action@v5
        with:
          context: ./server
          file: ./server/Dockerfile
          push: true
          tags: |
            ${{ env.BACKEND_IMAGE }}:${{ github.sha }}
            ${{ env.BACKEND_IMAGE }}:testing

      # -----------------------------
      # Build & Push AI
      # -----------------------------
      - name: Build & Push AI
        uses: docker/build-push-action@v5
        with:
          context: ./ai
          file: ./ai/Dockerfile
          push: true
          tags: |
            ${{ env.AI_IMAGE }}:${{ github.sha }}
            ${{ env.AI_IMAGE }}:testing

      # -----------------------------
      # Build & Push Nginx
      # -----------------------------
      - name: Build & Push Nginx
        uses: docker/build-push-action@v5
        with:
          context: ./nginx
          file: ./nginx/Dockerfile
          push: true
          tags: |
            ${{ env.NGINX_IMAGE }}:${{ github.sha }}
            ${{ env.NGINX_IMAGE }}:testing

      # -----------------------------
      # Update docker-compose with SHA tags
      # -----------------------------
      - name: Update docker-compose with SHA tags
        run: |
          echo "Updating docker-compose.yml with SHA tags..."
          sed -i "s|radykh/international_knowledge_front:testing|radykh/international_knowledge_front:${{ github.sha }}|g" docker-compose.yml
          sed -i "s|radykh/international_knowledge_back:testing|radykh/international_knowledge_back:${{ github.sha }}|g" docker-compose.yml
          sed -i "s|radykh/international_knowledge_ai:testing|radykh/international_knowledge_ai:${{ github.sha }}|g" docker-compose.yml
          sed -i "s|radykh/international_knowledge_nginx:testing|radykh/international_knowledge_nginx:${{ github.sha }}|g" docker-compose.yml
          echo "Updated docker-compose.yml:"
          cat docker-compose.yml | grep "image:"

      # -----------------------------
      # Commit updated docker-compose
      # -----------------------------
      - name: Commit and push updated docker-compose
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"
          git add docker-compose.yml
          git diff --staged --quiet || git commit -m "ci: Update image tags to SHA ${{ github.sha }}"
          git push origin testing

      # -----------------------------
      # Trigger Dokploy Deployment
      # -----------------------------
      - name: Trigger Dokploy Deployment
        run: |
          echo "Triggering Dokploy deployment..."
          sleep 5
          curl -s -L -X POST "${{ secrets.DOKPLOY_WEBHOOK_URL }}" \
            -H "Content-Type: application/json" \
            -d '{"branch":"testing"}'
			
			
			
